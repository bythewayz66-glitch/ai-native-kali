#!/bin/bash
# Stage the offline model bundle's *configuration* into the chroot.
#
# Phase 8, item 3. The weights themselves are staged by the build host (see
# packaging/fetch_bundle.py) and copied in as a directory; this hook installs the
# environment that points the runtime at them, and the manifest that records what
# was supposed to be there.
#
# The split matters: this hook runs on every build and is deterministic, while the
# weights are a large, network-dependent artifact. A build that has the config but
# not the weights produces an image that *reports* the missing bundle rather than
# one that silently falls back and looks fine.
set -e

PROFILE="${AI_PROFILE:-minimal}"
BUNDLE_ROOT="/opt/hermes/models"
ENV_FILE="/etc/kali-ai/model-bundle.env"

echo "[kali-ai-native] staging model bundle config for profile: $PROFILE"

install -d -m 0755 /etc/kali-ai
install -d -m 0700 "$BUNDLE_ROOT"

# The manifest the build host wrote, if it staged one.
if [ -f "/opt/ai-native-kali/bundle/manifest.json" ]; then
  install -D -m 0644 "/opt/ai-native-kali/bundle/manifest.json" /etc/kali-ai/model-bundle.json
  echo "  -> manifest installed"
else
  echo "  !! no bundle manifest staged; the image will report an empty bundle" >&2
fi

# The environment the runtime reads. Written from the manifest when present so the
# two cannot disagree; otherwise the safe default (lexical, no model).
if [ -f "/etc/kali-ai/model-bundle.json" ]; then
  EMBEDDER="$(python3 -c "import json;print(json.load(open('/etc/kali-ai/model-bundle.json'))['embedder_env']['MEMORY_EMBEDDER'])" 2>/dev/null || echo hashing)"
  EMBED_MODEL="$(python3 -c "import json;print(json.load(open('/etc/kali-ai/model-bundle.json'))['embedder_env'].get('MEMORY_EMBED_MODEL',''))" 2>/dev/null || echo '')"
else
  EMBEDDER="hashing"
  EMBED_MODEL=""
fi

cat > "$ENV_FILE" <<EOF
# Generated by 0010-model-bundle.hook.chroot - do not edit by hand.
AI_PROFILE=$PROFILE
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=$BUNDLE_ROOT
OLLAMA_OFFLINE=1
MEMORY_EMBEDDER=$EMBEDDER
MEMORY_EMBED_URL=http://127.0.0.1:11434
MEMORY_EMBED_MODEL=$EMBED_MODEL
EOF
chmod 0644 "$ENV_FILE"

echo "[kali-ai-native] model bundle config written to $ENV_FILE (embedder=$EMBEDDER)"
