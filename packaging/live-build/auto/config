#!/usr/bin/env bash
# live-build configuration for the AI-native Kali ISO (Phase 4 scaffold).
# Reference: blueprint section 07 (packaging & delivery).
#
# This is the real live-build entrypoint: `lb build` in a checkout that uses
# this directory reads auto/ first, then config/.
set -e

# The Kali archive must be named explicitly. Without --mirror-bootstrap /
# --mirror-chroot / --mirror-binary, live-build falls back to its Debian default
# (http://deb.debian.org/debian) and then asks it for `dists/kali-rolling/Release`
# -- a path that does not exist on the Debian mirror. debootstrap fails with
# "Failed getting release file .../dists/kali-rolling/Release" before the chroot
# is ever built. This was the real blocker on the first end-to-end `make iso-full`
# attempt (Phase 9); the mirror is now stated rather than inherited.
KALI_MIRROR="${KALI_MIRROR:-http://http.kali.org/kali}"

lb config noauto \
  --distribution kali-rolling \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-distribution kali-rolling \
  --mirror-bootstrap "$KALI_MIRROR" \
  --mirror-chroot "$KALI_MIRROR" \
  --mirror-chroot-security "$KALI_MIRROR" \
  --mirror-binary "$KALI_MIRROR" \
  --mirror-binary-security "$KALI_MIRROR" \
  --linux-flavours amd64 \
  --bootloader grub-efi \
  --binary-images iso-hybrid \
  --bootappend-live "boot=live components quiet splash username=kali hostname=kali-ai" \
  --iso-application "AI-native Kali" \
  --iso-publisher "AI-native Kali project" \
  --iso-volume "KALI_AI_NATIVE_$(date +%Y%m%d)" \
  --apt-indices false \
  --apt-recommends false \
  --security false \
  --updates false \
  --debian-installer false \
  --memtest none \
  --zsync false \
  "$@"

# The metapackages live in packaging/metapackages and are copied into the
# chroot by config/hooks/0005-install-metapackages.hook.chroot
