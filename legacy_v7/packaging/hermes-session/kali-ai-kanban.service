[Unit]
Description=AI-native Kali - Kanban orchestration core
After=network-online.target
PartOf=kali-ai.target

[Service]
Type=simple
Environment=KANBAN_DB=/var/lib/kali-ai/kanban.db
Environment=KANBAN_SEED=1
Environment=KANBAN_HOST=127.0.0.1
Environment=KANBAN_PORT=8081
ExecStart=/usr/bin/python3 -m uvicorn kanban_core.api:app --host 127.0.0.1 --port 8081
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kali-ai /var/log/kali-ai

[Install]
WantedBy=kali-ai.target
