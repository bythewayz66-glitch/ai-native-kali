# runtime state (regenerated by `make dev`)
var/db/
var/log/
var/run/
var/build/
# Phase 16: the collector's audit cursor. Runtime state, not source - committing
# it would bake one host's position in the chain into the tree and make every
# other checkout resume from a stranger's offset.
var/obs_cursors.json
**/var/obs_cursors.json
# python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
# node
node_modules/
# build scratch
*.iso
*.iso.zsync
*.img
*.qcow2
*.vmdk
*.vdi
# staged build output (regenerated by `make build`)
var/build/
dist/
build/

# live-build generated scratch (regenerated by `lb config` at the start of every
# `make iso`; see packaging/build-iso.sh). The *source* of truth in this tree is
# packaging/live-build/auto/* and the tracked config/ files (hooks/*.hook.chroot,
# includes.binary/, package-lists/kali-ai-native.list.chroot). lb then copies and
# rewrites those into the paths below, so they are build products - committing
# them would make the tree depend on whichever `lb config` ran last.
packaging/live-build/.build/
packaging/live-build/config/apt/
packaging/live-build/config/archives/
packaging/live-build/config/binary/
packaging/live-build/config/bootstrap/
packaging/live-build/config/chroot/
packaging/live-build/config/common/
packaging/live-build/config/source/
packaging/live-build/config/debian-installer/
packaging/live-build/config/includes/
packaging/live-build/config/includes.chroot_after_packages/
packaging/live-build/config/includes.chroot_before_packages/
packaging/live-build/config/includes.installer/
packaging/live-build/config/includes.source/
packaging/live-build/config/hooks/live/
packaging/live-build/config/hooks/normal/
packaging/live-build/config/package-lists/live.list.chroot
packaging/live-build/config/packages/
packaging/live-build/config/packages.binary/
packaging/live-build/config/packages.chroot/
packaging/live-build/config/preseed/
packaging/live-build/config/rootfs/
packaging/live-build/config/bootloaders/
*.deb
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
# model bundle weights (large binaries; fetched by packaging/fetch_bundle.py)
bundle/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.bin
